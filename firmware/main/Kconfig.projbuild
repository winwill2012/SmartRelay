menu "SmartRelay Runtime Config"

choice SR_LOG_PROFILE
    prompt "Chip log profile"
    default SR_LOG_PROFILE_DEV
    help
        Select logging detail level for development or production.

config SR_LOG_PROFILE_DEV
    bool "Development mode (verbose logs)"
    help
        Print detailed provisioning and MQTT command logs for debugging.

config SR_LOG_PROFILE_PROD
    bool "Production mode (core logs only)"
    help
        Keep only key startup/state/error logs for performance and security.

endchoice

config SR_FW_VERSION
    string "Firmware version"
    default "1.0.7"
    help
        Runtime reported firmware version string.

choice SR_RELAY_TRIGGER_LEVEL
    prompt "Relay trigger level"
    default SR_RELAY_ACTIVE_LOW
    help
        Select relay module active level.

config SR_RELAY_ACTIVE_LOW
    bool "Active low (LOW=ON)"
    help
        Typical for many relay boards with low-level trigger jumper.

config SR_RELAY_ACTIVE_HIGH
    bool "Active high (HIGH=ON)"
    help
        Use this for relay boards configured as high-level trigger.

endchoice

config SR_MQTT_HOST
    string "MQTT host"
    default "127.0.0.1"
    help
        MQTT broker hostname or IP.

config SR_MQTT_PORT
    int "MQTT port"
    range 1 65535
    default 1883
    help
        MQTT broker TCP port.

config SR_MQTT_USER
    string "MQTT username"
    default "SmartRelay"
    help
        MQTT authentication username.

config SR_MQTT_PASS
    string "MQTT password"
    default "change_me"
    help
        MQTT authentication password.

config SR_VERBOSE_MQTT_RX_LOG
    bool "Verbose MQTT RX logs (debug only)"
    default n
    help
        Print per-message MQTT enqueue/dequeue and payload logs.
        Keep disabled for stress tests to avoid UART bottleneck.

endmenu
