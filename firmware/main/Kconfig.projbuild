menu "SmartRelay Runtime Config"

choice SR_LOG_PROFILE
    prompt "Chip log profile"
    default SR_LOG_PROFILE_DEV
    help
        Select logging detail level for development or production.

config SR_LOG_PROFILE_DEV
    bool "Development mode (verbose logs)"
    help
        Print detailed provisioning and MQTT command logs for debugging.

config SR_LOG_PROFILE_PROD
    bool "Production mode (core logs only)"
    help
        Keep only key startup/state/error logs for performance and security.

endchoice

config SR_FW_VERSION
    string "Firmware version"
    default "1.0.7"
    help
        Runtime reported firmware version string.

config SR_MQTT_HOST
    string "MQTT host"
    default "127.0.0.1"
    help
        MQTT broker hostname or IP.

config SR_MQTT_PORT
    int "MQTT port"
    range 1 65535
    default 1883
    help
        MQTT broker TCP port.

config SR_MQTT_USER
    string "MQTT username"
    default "SmartRelay"
    help
        MQTT authentication username.

config SR_MQTT_PASS
    string "MQTT password"
    default "change_me"
    help
        MQTT authentication password.

endmenu
