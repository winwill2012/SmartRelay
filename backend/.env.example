# 复制为 .env 后修改；勿提交真实生产密码
# 默认值仅便于本地联调，与 resource.example.md 对齐时请自行覆盖

APP_NAME=SmartRelay API
PUBLIC_BASE_URL=http://127.0.0.1:8000
LISTEN_HOST=0.0.0.0
LISTEN_PORT=8000

MYSQL_HOST=127.0.0.1
MYSQL_PORT=3306
MYSQL_USER={你的数据库用户名，记不住可以去看一下3.6节课当初创建的啥}
MYSQL_PASSWORD={你的数据库密码，记不住可以去看一下3.6节课当初设置的啥}
MYSQL_DATABASE={你的数据库的你名字，记不住可以去看一下3.6节课当初创建的啥}

JWT_SECRET={用视频中讲解的生成方式生成一个随机密钥}

MQTT_HOST=127.0.0.1
MQTT_PORT=1883
MQTT_USERNAME={你的EMQX用户名，记不住可以看一下3.8节当初创建的啥}
MQTT_PASSWORD={你的EMQX密码，记不住可以看一下3.8节当初设置的啥}
MQTT_CLIENT_ID=sr_backend_v1

# 设备离线判定（秒），默认 15，与协议一致
DEVICE_OFFLINE_SECONDS=15

# 默认管理员（首次启动写入 admin_users，密码 bcrypt）
ADMIN_DEFAULT_USERNAME=admin
ADMIN_DEFAULT_PASSWORD=admin123

# 微信小程序（留空则 dev 模式用 code 派生 openid）
WECHAT_APP_ID={去微信公众平台看小程序的APP_ID，替换，详细请看视频讲解}
WECHAT_SECRET={去微信公众平台看小程序的APP_SECRET，替换，详细请看视频讲解}

# 设置固件上传的保存路径，不用修改
UPLOAD_DIR=/data/smart-relay/uploads
