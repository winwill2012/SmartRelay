.page {
  padding: 24rpx 32rpx 80rpx;
}

.hint {
  text-align: center;
  color: #64748b;
  padding: 48rpx 0;
}

.group-title {
  font-size: 24rpx;
  color: #475569;
  font-weight: 600;
  margin: 8rpx 0 16rpx;
}

.card.item {
  padding: 28rpx;
  margin-bottom: 20rpx;
}

.t {
  font-size: 30rpx;
  font-weight: 600;
  color: #0f172a;
  display: block;
}

.id-text {
  display: block;
  margin-top: 8rpx;
  color: #94a3b8;
  font-size: 22rpx;
  font-family: ui-monospace, monospace;
}

.s {
  font-size: 24rpx;
  color: #64748b;
  margin-top: 8rpx;
  display: block;
}

.row-actions {
  margin-top: 20rpx;
  display: flex;
  gap: 16rpx;
}

.act {
  flex: 1;
  border-radius: 16rpx;
  line-height: 76rpx;
  font-size: 26rpx;
  padding: 0;
}

.act::after {
  border: none;
}

.act-detail {
  background: linear-gradient(180deg, #eff6ff 0%, #dbeafe 100%);
  color: #1d4ed8;
  font-weight: 600;
  border: 2rpx solid #bfdbfe;
}

.act-cancel {
  background: linear-gradient(180deg, #fef2f2 0%, #fee2e2 100%);
  color: #b91c1c;
  font-weight: 600;
  border: 2rpx solid #fecaca;
}

.invite-card {
  padding: 36rpx 32rpx;
  margin-bottom: 24rpx;
  border-radius: 24rpx;
  background: linear-gradient(180deg, #f0fdf4 0%, #ffffff 48%);
  border: 2rpx solid #bbf7d0;
}

.invite-title {
  font-size: 28rpx;
  font-weight: 600;
  color: #166534;
  display: block;
}

.invite-device {
  display: block;
  margin-top: 20rpx;
  font-size: 34rpx;
  font-weight: 700;
  color: #0f172a;
}

.invite-meta {
  display: block;
  margin-top: 12rpx;
  font-size: 26rpx;
  color: #64748b;
}

.invite-actions {
  margin-top: 28rpx;
  display: flex;
  gap: 16rpx;
}

.act-accept {
  flex: 1;
  background: linear-gradient(180deg, #34d399 0%, #10b981 100%);
  color: #ffffff;
  font-weight: 600;
  border: 2rpx solid #059669;
}

.act-reject {
  flex: 1;
  background: #ffffff;
  color: #475569;
  font-weight: 600;
  border: 2rpx solid #e2e8f0;
}

