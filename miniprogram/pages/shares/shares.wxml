<view class="page">
  <view wx:if="{{loading}}" class="hint">加载中…</view>
  <block wx:elif="{{showInvite && invite}}">
    <view class="invite-card">
      <text class="invite-title">收到设备分享邀请</text>
      <text class="invite-device">{{invite.device_display_name || invite.device_id || '未知设备'}}</text>
      <text class="invite-meta">来自 {{invite.owner_display_name || '设备拥有者'}}</text>
      <text wx:if="{{invite.device_id}}" class="id-text" data-id="{{invite.device_id}}" bindtap="copyDeviceId">设备ID {{invite.device_id}}</text>
      <view class="invite-actions">
        <button class="act act-accept" bindtap="onAcceptInvite">接受</button>
        <button class="act act-reject" bindtap="onRejectInvite">拒绝</button>
      </view>
    </view>
  </block>
  <view wx:elif="{{createdList.length === 0 && joinedList.length === 0}}" class="hint">暂无分享记录</view>
  <view wx:else>
    <view wx:if="{{joinedList.length > 0}}" class="group-title">我加入的设备</view>
    <view wx:for="{{joinedList}}" wx:key="id" class="card item">
      <text class="t">{{item.device_display_name || item.device_name || item.device_id || '未知设备'}}</text>
      <text wx:if="{{item.device_id}}" class="id-text" data-id="{{item.device_id}}" bindtap="copyDeviceId">设备ID {{item.device_id}}</text>
      <text class="s">{{item.status_text || '已接受'}}</text>
      <text class="s">来源：{{item.owner_display_name || '设备拥有者'}}</text>
      <view class="row-actions">
        <button class="act act-detail" data-group="joined" data-index="{{index}}" bindtap="onViewDetail">查看详情</button>
      </view>
    </view>

    <view wx:if="{{createdList.length > 0}}" class="group-title">我发起的分享</view>
    <view wx:for="{{createdList}}" wx:key="id" class="card item">
      <text class="t">{{item.device_display_name || item.device_name || item.device_id || '未知设备'}}</text>
      <text wx:if="{{item.device_id}}" class="id-text" data-id="{{item.device_id}}" bindtap="copyDeviceId">设备ID {{item.device_id}}</text>
      <text class="s">{{item.status_text || '待接受'}}</text>
      <text class="s">被分享者：{{item.target_display_name || '待接受'}}</text>
      <view class="row-actions">
        <button class="act act-detail" data-group="created" data-index="{{index}}" bindtap="onViewDetail">查看详情</button>
        <button class="act act-cancel" data-index="{{index}}" bindtap="onCancelShare">取消分享</button>
      </view>
    </view>
  </view>
</view>
