<view class="page">
  <view class="card block">
    <text class="lab">当前设备</text>
    <text class="val mono">{{device_id}}</text>
  </view>

  <button class="btn-check" loading="{{loading}}" disabled="{{otaBusy}}" bindtap="onCheck">检查更新</button>

  <view wx:if="{{result}}" class="card result">
    <block wx:if="{{result.latest}}">
      <text class="lab">设备当前版本</text>
      <text class="val mono">{{result.current_version}}</text>
      <text class="lab row-gap">服务器最新版本</text>
      <text class="ver">{{result.latest.version}}</text>
      <text wx:if="{{result.latest.release_notes}}" class="notes">{{result.latest.release_notes}}</text>
      <block wx:if="{{result.update_available}}">
        <text class="status-chip status-chip--warn">有新版本可升级</text>
        <button
          class="btn-upgrade"
          loading="{{otaBusy}}"
          disabled="{{otaBusy}}"
          bindtap="onStartOta"
        >立即更新</button>
      </block>
      <text wx:else class="status-chip status-chip--ok">已与此版本一致</text>
    </block>
    <block wx:else>
      <text class="lab">服务器最新版本</text>
      <text class="ver muted">—</text>
      <text class="msg">暂无已启用的固件版本，请在管理后台「固件管理」中启用目标版本后再试。</text>
    </block>
    <text wx:if="{{result.message}}" class="msg">{{result.message}}</text>
  </view>

  <view wx:if="{{otaBusy || otaProgress || otaPollHint}}" class="card ota-progress-card">
    <text class="lab">升级进度</text>
    <text class="ota-phase">{{otaStageText || (otaProgress.phase ? otaProgress.phase : '—')}}</text>

    <view class="ota-flow">
      <view class="ota-step {{flowDownloadState}}">
        <view class="dot"></view>
        <text>下载</text>
      </view>
      <view class="ota-line {{flowInstallState == 'pending' ? '' : 'active'}}"></view>
      <view class="ota-step {{flowInstallState}}">
        <view class="dot"></view>
        <text>更新</text>
      </view>
      <view class="ota-line {{flowRebootState == 'pending' ? '' : 'active'}}"></view>
      <view class="ota-step {{flowRebootState}}">
        <view class="dot"></view>
        <text>重启</text>
      </view>
      <view class="ota-line {{flowDoneState == 'pending' ? '' : 'active'}}"></view>
      <view class="ota-step {{flowDoneState}}">
        <view class="dot"></view>
        <text>完成</text>
      </view>
    </view>

    <progress class="ota-bar" percent="{{otaProgressPercent}}" show-info stroke-width="10" active="{{false}}" />
    <view wx:if="{{otaPollHint && flowDoneState == 'done'}}" class="ota-success">
      <text class="ota-success-icon">✓</text>
      <text class="ota-success-text">恭喜，{{otaPollHint}}</text>
    </view>
    <text wx:elif="{{otaPollHint}}" class="msg ota-hint warn">{{otaPollHint}}</text>
  </view>
</view>
