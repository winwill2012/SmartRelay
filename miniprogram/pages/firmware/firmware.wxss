.page {
  padding: 32rpx;
}

.block {
  padding: 32rpx;
  background: linear-gradient(180deg, #fafbff 0%, #fff 55%);
}

.lab {
  font-size: 24rpx;
  color: #64748b;
  display: block;
}

.lab.row-gap {
  margin-top: 24rpx;
}

.val {
  display: block;
  margin-top: 12rpx;
  font-size: 28rpx;
  color: #0f172a;
}

.mono {
  font-family: ui-monospace, monospace;
}

.btn-check {
  margin-top: 32rpx;
  width: 100%;
  background: linear-gradient(135deg, #3b82f6 0%, #2563eb 55%, #1d4ed8 100%);
  color: #fff;
  font-weight: 600;
  font-size: 30rpx;
  border-radius: 24rpx;
  line-height: 88rpx;
  padding: 0;
  box-shadow: 0 12rpx 28rpx rgba(37, 99, 235, 0.28);
}

.btn-check::after {
  border: none;
}

.btn-upgrade {
  margin-top: 28rpx;
  width: 100%;
  background: linear-gradient(135deg, #f59e0b 0%, #d97706 100%);
  color: #fff;
  font-weight: 600;
  font-size: 30rpx;
  border-radius: 24rpx;
  line-height: 88rpx;
  padding: 0;
  box-shadow: 0 12rpx 28rpx rgba(217, 119, 6, 0.28);
}

.btn-upgrade::after {
  border: none;
}

.ota-progress-card {
  margin-top: 24rpx;
  padding: 28rpx;
  border: 1rpx solid #e2e8f0;
  border-radius: 20rpx;
  background: linear-gradient(180deg, #f8fbff 0%, #ffffff 70%);
}

.ota-phase {
  display: block;
  margin-top: 12rpx;
  font-size: 28rpx;
  color: #334155;
}

.ota-bar {
  margin-top: 14rpx;
  width: 100%;
}

.ota-hint {
  margin-top: 16rpx;
}

.ota-hint.warn {
  color: #b45309;
}

.ota-success {
  margin-top: 16rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  gap: 8rpx;
  background: #ecfdf3;
  border: 1rpx solid #86efac;
  border-radius: 14rpx;
  padding: 12rpx 14rpx;
}

.ota-success-icon {
  color: #16a34a;
  font-size: 28rpx;
  font-weight: 700;
}

.ota-success-text {
  color: #166534;
  font-size: 24rpx;
  font-weight: 600;
}

.ota-flow {
  margin-top: 16rpx;
  display: flex;
  align-items: center;
}

.ota-step {
  display: flex;
  flex-direction: column;
  align-items: center;
  color: #94a3b8;
  font-size: 20rpx;
  min-width: 68rpx;
  text-align: center;
}

.ota-step .dot {
  width: 18rpx;
  height: 18rpx;
  border-radius: 50%;
  background: #cbd5e1;
  margin-bottom: 8rpx;
}

.ota-step.active,
.ota-step.done {
  color: #1d4ed8;
}

.ota-step.active .dot {
  background: #2563eb;
  box-shadow: 0 0 0 6rpx rgba(37, 99, 235, 0.15);
}

.ota-step.done .dot {
  background: #16a34a;
}

.ota-line {
  flex: 1;
  height: 4rpx;
  background: #e2e8f0;
  margin: 0 6rpx 24rpx;
}

.ota-line.active {
  background: #60a5fa;
}

.result {
  margin-top: 32rpx;
  padding: 32rpx;
}

.ver {
  display: block;
  margin-top: 12rpx;
  font-size: 40rpx;
  font-weight: 700;
  color: #2563eb;
}

.ver.muted {
  color: #94a3b8;
  font-weight: 600;
}

.hint-new {
  color: #b45309;
}

.hint-ok {
  color: #15803d;
}

.status-chip {
  display: inline-block;
  margin-top: 22rpx;
  padding: 6rpx 14rpx;
  border-radius: 999rpx;
  font-size: 22rpx;
  line-height: 1.3;
  font-weight: 600;
}

.status-chip--ok {
  color: #166534;
  background: #dcfce7;
  border: 1rpx solid #86efac;
}

.status-chip--warn {
  color: #9a3412;
  background: #ffedd5;
  border: 1rpx solid #fdba74;
}

.notes {
  display: block;
  margin-top: 16rpx;
  font-size: 26rpx;
  color: #475569;
  line-height: 1.5;
}

.msg {
  display: block;
  margin-top: 12rpx;
  font-size: 26rpx;
  color: #64748b;
}
