<view class="page">
  <view class="bg-blob bg-blob--a" />
  <view class="bg-blob bg-blob--b" />

  <view class="main">
    <!-- 品牌 + 登录：同一竖条，间距紧凑；整组在页面垂直居中 -->
    <view class="brand-area">
      <view class="logo-wrap">
        <view class="logo-card">
          <image class="brand-logo" src="../../Logo.jpg" mode="widthFix" />
        </view>
      </view>
      <text class="tagline">智能开关 · 远程随心</text>
    </view>

    <view class="action-area">
      <button class="wx-btn" loading="{{loading}}" bindtap="onWxLogin" hover-class="wx-btn-hover">
        <text class="wx-btn-label">微信一键登录</text>
      </button>

      <view class="legal">
        <text class="legal-text">登录即表示同意</text>
        <navigator
          class="legal-link"
          url="/pages/user-agreement/user-agreement"
          hover-class="legal-link-hover"
        >《用户协议》</navigator>
        <text class="legal-text">与</text>
        <navigator
          class="legal-link"
          url="/pages/privacy-policy/privacy-policy"
          hover-class="legal-link-hover"
        >《隐私政策》</navigator>
      </view>
    </view>
  </view>
</view>
