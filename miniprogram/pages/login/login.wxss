/* 登录页：Logo、副文案、登录按钮为一组，组内间距紧凑；整组在页面垂直居中 */

.page {
  position: relative;
  min-height: 100vh;
  box-sizing: border-box;
  overflow: hidden;
  background: linear-gradient(
    165deg,
    #e8ecff 0%,
    #f0edff 32%,
    #f8fafc 58%,
    #ffffff 100%
  );
}

.bg-blob {
  position: absolute;
  pointer-events: none;
  border-radius: 50%;
  opacity: 0.55;
}

.bg-blob--a {
  width: 520rpx;
  height: 520rpx;
  top: -160rpx;
  right: -140rpx;
  background: radial-gradient(circle, rgba(99, 102, 241, 0.22) 0%, transparent 68%);
}

.bg-blob--b {
  width: 420rpx;
  height: 420rpx;
  bottom: 120rpx;
  left: -120rpx;
  background: radial-gradient(circle, rgba(59, 130, 246, 0.14) 0%, transparent 70%);
}

.main {
  position: relative;
  z-index: 1;
  min-height: 100vh;
  box-sizing: border-box;
  display: flex;
  flex-direction: column;
  justify-content: center;
  align-items: stretch;
  padding: 32rpx 48rpx calc(40rpx + env(safe-area-inset-bottom));
}

.brand-area {
  display: flex;
  flex-direction: column;
  align-items: center;
  flex-shrink: 0;
}

.logo-wrap {
  width: 100%;
  display: flex;
  justify-content: center;
}

.logo-card {
  max-width: 100%;
  padding: 20rpx 24rpx;
  border-radius: 28rpx;
  background: rgba(255, 255, 255, 0.92);
  box-shadow:
    0 4rpx 6rpx -1rpx rgba(15, 23, 42, 0.06),
    0 24rpx 48rpx -12rpx rgba(15, 23, 42, 0.08),
    0 0 0 1rpx rgba(255, 255, 255, 0.9) inset;
}

.brand-logo {
  width: 260rpx;
  max-width: 100%;
  display: block;
  border-radius: 16rpx;
}

.tagline {
  margin-top: 20rpx;
  font-size: 24rpx;
  font-weight: 500;
  letter-spacing: 0.1em;
  color: #64748b;
}

/* 与上方副文案仅留一小段间距，避免与 Logo「一上一下」割裂 */
.action-area {
  margin-top: 32rpx;
  flex-shrink: 0;
  width: 100%;
  box-sizing: border-box;
  display: flex;
  flex-direction: column;
  align-items: stretch;
}

.wx-btn[disabled] {
  background: #9dd9b5 !important;
  color: rgba(255, 255, 255, 0.85);
  box-shadow: none;
}

.wx-btn {
  width: 100%;
  height: 96rpx;
  line-height: 96rpx;
  padding: 0;
  border-radius: 48rpx;
  background: #07c160;
  color: #fff;
  font-size: 32rpx;
  font-weight: 600;
  display: flex;
  align-items: center;
  justify-content: center;
  box-shadow: 0 10rpx 28rpx rgba(7, 193, 96, 0.28);
}

.wx-btn::after {
  border: none;
}

.wx-btn-hover {
  opacity: 0.92;
}

.wx-btn-label {
  letter-spacing: 0.06em;
}

/* 与下方按钮同宽区域，内部协议行按内容宽度收缩并水平居中 */
.legal {
  margin-bottom: 28rpx;
  padding: 0;
  width: 100%;
  box-sizing: border-box;
}

.legal-inner {
  width: 100%;
  text-align: center;
  box-sizing: border-box;
}

/* 原生组件对 flex 支持不一：用行内块整体居中，内部文案仍左对齐阅读 */
.legal-group {
  display: inline-block;
  max-width: 100%;
  text-align: left;
  vertical-align: top;
}

.legal-row {
  display: flex;
  flex-direction: row;
  align-items: center;
  max-width: 100%;
  box-sizing: border-box;
}

/* 与右侧文案行高对齐；去掉 margin-top，避免与 flex-start 叠加导致错位 */
.legal-cb {
  margin-right: 12rpx;
  flex-shrink: 0;
  align-self: center;
}

.legal-body {
  flex: 0 1 auto;
  min-width: 0;
  display: flex;
  flex-wrap: wrap;
  align-items: center;
  align-content: center;
  row-gap: 6rpx;
  column-gap: 4rpx;
}

.legal-text {
  font-size: 22rpx;
  line-height: 1.65;
  color: #94a3b8;
}

.legal-link {
  display: inline;
  font-size: 22rpx;
  line-height: 1.65;
  color: #4f46e5;
  font-weight: 500;
}

.legal-link-hover {
  opacity: 0.72;
}
