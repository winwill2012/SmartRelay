<view class="tab-bar">
  <view class="tab-bar__hairline"/>
  <view class="tab-bar__row">
    <view
      wx:for="{{list}}"
      wx:key="pagePath"
      class="tab-bar__item"
      data-index="{{index}}"
      bindtap="switchTab"
      hover-class="tab-bar__item--hover"
      hover-stay-time="80"
    >
      <image
        class="tab-bar__icon"
        src="{{selected === index ? item.selectedIconPath : item.iconPath}}"
        mode="aspectFit"
      />
      <view
        class="tab-bar__text"
        style="color: {{selected === index ? selectedColor : color}};"
      >{{item.text}}</view>
    </view>
  </view>
  <view class="tab-bar__safe"/>
</view>
