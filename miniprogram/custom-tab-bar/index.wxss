/* 与页面 padding-bottom / fab 的 TAB_BAR_CLEARANCE_RPX 保持一致（app.wxss、devices、mine） */
.tab-bar {
  position: fixed;
  left: 0;
  right: 0;
  bottom: 0;
  z-index: 99999;
  background: #ffffff;
  box-sizing: border-box;
  box-shadow: 0 -4rpx 24rpx rgba(15, 23, 42, 0.06);
}

.tab-bar__hairline {
  height: 1rpx;
  background: rgba(148, 163, 184, 0.35);
  transform: scaleY(0.5);
  transform-origin: 0 0;
}

.tab-bar__row {
  display: flex;
  flex-direction: row;
  align-items: stretch;
  justify-content: space-around;
  box-sizing: border-box;
  min-height: 148rpx;
  padding: 14rpx 32rpx 10rpx;
}

.tab-bar__item {
  flex: 1;
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  min-width: 0;
  padding: 8rpx 16rpx;
  /* 扩大可点区域，避免 iPhone 上显得过小 */
  min-height: 108rpx;
}

.tab-bar__item--hover {
  opacity: 0.82;
}

.tab-bar__icon {
  width: 72rpx;
  height: 72rpx;
  flex-shrink: 0;
}

.tab-bar__text {
  margin-top: 10rpx;
  font-size: 28rpx;
  line-height: 1.2;
  font-weight: 500;
}

.tab-bar__safe {
  width: 100%;
  /* 兼容旧版 iOS */
  padding-bottom: constant(safe-area-inset-bottom);
  padding-bottom: env(safe-area-inset-bottom);
  background: #ffffff;
}
