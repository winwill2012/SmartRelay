/* 主栏视觉高度约 112rpx（不含底部安全区）；与 app.wxss / devices / mine 中112rpx 占位一致 */
.tab-bar {
  position: fixed;
  left: 0;
  right: 0;
  bottom: 0;
  z-index: 99999;
  background: #ffffff;
  box-sizing: border-box;
  box-shadow: 0 -4rpx 24rpx rgba(15, 23, 42, 0.06);
}

.tab-bar__hairline {
  height: 1rpx;
  background: rgba(148, 163, 184, 0.35);
  transform: scaleY(0.5);
  transform-origin: 0 0;
}

.tab-bar__row {
  display: flex;
  flex-direction: row;
  align-items: center;
  justify-content: space-around;
  box-sizing: border-box;
  padding: 6rpx 24rpx 4rpx;
}

.tab-bar__item {
  flex: 1;
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  min-width: 0;
  padding: 8rpx 20rpx;
  min-height: 88rpx;
}

.tab-bar__item--hover {
  opacity: 0.82;
}

.tab-bar__icon {
  width: 60rpx;
  height: 60rpx;
  flex-shrink: 0;
}

.tab-bar__text {
  margin-top: 6rpx;
  font-size: 26rpx;
  line-height: 1.2;
  font-weight: 500;
}

.tab-bar__safe {
  width: 100%;
  /* 兼容旧版 iOS */
  padding-bottom: constant(safe-area-inset-bottom);
  padding-bottom: env(safe-area-inset-bottom);
  background: #ffffff;
}
